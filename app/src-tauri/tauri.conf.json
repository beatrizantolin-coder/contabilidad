{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Conta-Nice",
  "version": "1.5.1708",
  "identifier": "com.beatrizantolin.contabilidad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Conta-Nice",
        "width": 1180,
        "height": 780,
        "minWidth": 1080,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["nice"],
        "name": "Documento de Conta-Nice",
        "description": "Documento de Conta-Nice",
        "role": "Editor",
        "exportedType": {
          "identifier": "com.beatrizantolin.contabilidad.nice",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
